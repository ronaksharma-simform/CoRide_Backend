// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  firstName     String
  middleName    String    @default("")
  lastName      String
  email         String    @unique
  password      String
  phone         String    @unique
  orgName       String
  role          String
  gender        String
  isOrgVerified Boolean   @default(false)
  refreshToken  String    @default("")
  isIdVerified  Boolean   @default(false)
  avgRating     Float     @default(0)
  totalRides    Int       @default(0)
  createdAt     DateTime  @default(now())
  vehicles      Vehicle[]
  rides         Ride[]
  payments      Payment[]

  @@index([email])
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @default("")
  type      String   @default("Email Verification")
  expiresAt DateTime @default(now())

  @@index([token])
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  company      String
  model        String
  color        String
  plateNumber  String   @unique
  seatCapacity Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  rides        Ride[]

  @@index([userId])
}

enum RideStatus {
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

model Ride {
  id               String                                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String
  vehicleId        String
  sourceLabel      Unsupported("GEOGRAPHY(POINT,4326)")
  destinationLabel Unsupported("GEOGRAPHY(POINT,4326)")
  route            Unsupported("GEOGRAPHY(LINESTRING , 4326)")
  departureTime    DateTime
  totalSeats       Int
  availableSeats   Int
  status           RideStatus                                 @default(ACTIVE)
  createdAt        DateTime                                   @default(now())
  updatedAt        DateTime                                   @default(now())
  user             User                                       @relation(fields: [providerId], references: [id])
  vehicle          Vehicle                                    @relation(fields: [vehicleId], references: [id])
  payments         Payment[]
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  TIMED_OUT
  REFUNDED
}

// All money is stored in minor currency units (integers), never floats.
model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId          String        @db.Uuid
  riderId         String
  distanceMeters  Int
  durationMinutes Int
  surgeMultiplier Float
  baseFare        Int
  distanceFare    Int
  timeFare        Int
  amount          Int
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  failureReason   String?
  refundReason    String?
  gatewayRef      String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  ride            Ride          @relation(fields: [rideId], references: [id])
  rider           User          @relation(fields: [riderId], references: [id])

  @@unique([rideId, riderId])
  @@index([riderId])
  @@index([status])
}
