// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  firstName     String
  middleName    String    @default("")
  lastName      String
  email         String    @unique
  password      String
  phone         String    @unique
  orgName       String
  role          String
  gender        String
  isOrgVerified Boolean   @default(false)
  refreshToken  String    @default("")
  isIdVerified  Boolean   @default(false)
  avgRating     Float     @default(0)
  totalRides    Int       @default(0)
  createdAt     DateTime  @default(now())
  vehicles      Vehicle[]
  rides         Ride[]
  rideRequests  RideRequest[]

  @@index([email])
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @default("")
  type      String   @default("Email Verification")
  expiresAt DateTime @default(now())

  @@index([token])
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  company      String
  model        String
  color        String
  plateNumber  String   @unique
  seatCapacity Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  rides        Ride[]

  @@index([userId])
}

enum RideStatus {
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

model Ride {
  id               String                                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String
  vehicleId        String
  sourceLabel      Unsupported("GEOGRAPHY(POINT,4326)")
  destinationLabel Unsupported("GEOGRAPHY(POINT,4326)")
  route            Unsupported("GEOGRAPHY(LINESTRING , 4326)")
  departureTime    DateTime
  totalSeats       Int
  availableSeats   Int
  status           RideStatus                                 @default(ACTIVE)
  createdAt        DateTime                                   @default(now())
  updatedAt        DateTime                                   @default(now())
  user             User                                       @relation(fields: [providerId], references: [id])
  vehicle          Vehicle                                    @relation(fields: [vehicleId], references: [id])
  rideRequests     RideRequest[]
}

enum MatchStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  NO_DRIVERS
  CANCELLED
}

enum MatchEventType {
  REQUESTED
  ASSIGNED
  REJECTED
  ACCEPTED
  NO_DRIVERS
  CANCELLED
}

model RideRequest {
  id             String       @id @default(uuid())
  riderId        String
  pickupLat      Float
  pickupLng      Float
  destinationLat Float
  destinationLng Float
  status         MatchStatus  @default(PENDING)
  rideId         String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rider          User         @relation(fields: [riderId], references: [id])
  ride           Ride?        @relation(fields: [rideId], references: [id])
  events         MatchEvent[]

  @@index([riderId])
  @@index([rideId])
}

model MatchEvent {
  id        String         @id @default(uuid())
  requestId String
  rideId    String?        @db.Uuid
  type      MatchEventType
  createdAt DateTime       @default(now())
  request   RideRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}
